# Copy this file to `.env` and fill in your own key. NEVER commit `.env`.
#
# MedGuard uses Google Gemini via ADK. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Tells ADK to use the AI Studio (Gemini Developer API) backend rather than Vertex.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: override the model (defaults to gemini-2.0-flash).
# MEDGUARD_MODEL=gemini-2.0-flash
